# Crown & Blade Barber Co. - Environment Configuration
# Add these variables to your Vercel Project Settings > Environment Variables

# Shop branding and display name
VITE_SHOP_NAME="Crown & Blade Barber Co."

# Contact phone number displayed across header, footer, and booking modal
VITE_SHOP_PHONE="+1 (555) 382-7294"

# Street address for the barbershop
VITE_SHOP_ADDRESS="142 River Street, Suite 4, Mill Quarter"

# Production URL where the site is hosted on Vercel
VITE_SITE_URL="https://crown-and-blade-barber.vercel.app"

# Optional announcement or booking policy notice banner
VITE_BOOKING_NOTICE="Walk-ins welcome based on chair availability; online appointments guaranteed."
